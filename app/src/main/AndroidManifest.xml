<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.camera.level.full"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.capability.raw"
        android:required="false" />

        <!-- Nijatva family: needed on Android 11+ to see and launch these apps -->
    <queries>
        <package android:name="com.nijatva.photos" />
        <package android:name="com.nijatva.gallery" />
        <package android:name="com.nijatva.camera" />
        <package android:name="com.nijatva.photo.editor" />
        <package android:name="com.nijatva.videoplayer" />
        <package android:name="com.nijatva.music.player" />
        <package android:name="com.nijatva.file" />
        <package android:name="in.nijatva.browser" />
        <package android:name="com.nijatva.messages" />
        <package android:name="com.nijatva.contacts" />
        <package android:name="com.nijatva.dialer" />
        <package android:name="com.nijatva.drive" />
            <package android:name="com.nijatva.mini.x" />
        <package android:name="com.nijatva.wtrlab" />
    </queries>
<application
        android:name=".NijatvaApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nijatva">

        <!-- The Nijatva signature, shared with every app in the suite -->
        <activity
            android:name="com.nijatva.signature.SignatureDeveloperActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Nijatva">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Being a camera, not just an app with a shutter button: these two
                 filters are what let a messaging app, a file manager or the system
                 ask this app for a photo or a clip and get a result back. -->
            <intent-filter>
                <action android:name="android.media.action.IMAGE_CAPTURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.media.action.VIDEO_CAPTURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
            <!-- Nijatva signature: who made this build, for anyone who inspects the APK -->
        <meta-data android:name="developer.name" android:value="Vasudev Dangaya" />
        <meta-data android:name="developer.origin" android:value="India" />
        <meta-data android:name="developer.site" android:value="https://vasudev-work.github.io" />
        <meta-data android:name="nijatva.suite" android:value="Nijatva" />
        <meta-data android:name="nijatva.signature" android:value="com.nijatva.signature" />

</application>

</manifest>
